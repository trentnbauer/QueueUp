# QueueUp - RECOMMENDED .env for docker-compose.prod.yml: the minimum plus prices, Steam, and
# Cloudflare (sign-in captcha + tunnel, so no port needs opening).
# Copy to .env next to the compose file and fill in the blanks. See .env.example for every setting.

# --- Database password (used by the bundled Postgres container) ---
POSTGRES_PASSWORD=change-me-to-something-long

# --- Server ---
# The address people open QueueUp at (no trailing slash). With the Cloudflare Tunnel below, this is
# the tunnel's public hostname.
APP_BASE_URL=https://queueup.example.com
# At least 32 characters - generate one with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated emails that get Administrator settings when they sign in.
ADMIN_EMAILS=you@example.com
# Image tag for the compose files: latest, or (QueueUp image only) an exact version (1.5.1) or a rolling one (1.5, 1).
# The same value is used for the redis and ollama images, so a version-specific tag only works if they publish it too.
QueueUpVer=latest

# --- Sign-in: configure one or more (each shows a button on the sign-in page) ---
# Register <APP_BASE_URL>/auth/<provider>/callback as the redirect URL with each provider.
# Discord - https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google - https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Steam - https://steamcommunity.com/dev/apikey. Also powers Steam library/wishlist import,
# achievement sync and playtime tracking, so worth setting even if nobody signs in with Steam.
STEAM_API_KEY=

# --- Game data ---
# IGDB game search (free via https://dev.twitch.tv/console/apps). Needed to add games.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# gg.deals prices and price alerts (free key at https://gg.deals/api/).
GGDEALS_API_KEY=
# Default price region: us, gb, eu, au, ca or br (each user can change their own).
GGDEALS_DEFAULT_REGION=us

# --- Cloudflare Turnstile: captcha on the sign-in page (https://dash.cloudflare.com -> Turnstile) ---
# Add your QueueUp hostname to the widget's allowed hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Analytics (https://analytics.google.com) - optional ---
# Your GA4 measurement ID (G-XXXXXXXXXX). Each user is asked to opt in (setup and Settings);
# nothing is sent for anyone who hasn't.
GA_MEASUREMENT_ID=

# --- Cloudflare Tunnel (https://one.dash.cloudflare.com -> Networks -> Tunnels) ---
# QueueUp runs cloudflared itself. Point the tunnel's public hostname at http://localhost:3000 and
# set APP_BASE_URL above to that hostname. You can then remove `ports:` from the compose file.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional extras ---
# Steam playtime nudges ("you played X, mark it Playing?"). Needs STEAM_API_KEY.
PLAYTIME_TRACKING_ENABLED=false
# Barcode scanning of physical games on Add Game (https://scandex.gamery.app).
SCANDEX_API_KEY=
