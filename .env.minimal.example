# QueueUp - MINIMUM .env to run with docker-compose.prod.yml.
# Copy to .env next to the compose file and fill in the blanks. Everything not listed here falls
# back to a sensible default; see .env.recommended.example for the usual extras and .env.example
# for every setting.

# --- Database password (used by the bundled Postgres container) ---
POSTGRES_PASSWORD=change-me-to-something-long

# --- Server ---
# The address people open QueueUp at (no trailing slash).
APP_BASE_URL=https://queueup.example.com
# At least 32 characters - generate one with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated emails that get Administrator settings when they sign in.
ADMIN_EMAILS=you@example.com

# --- Sign-in: at least one method ---
# Discord shown here; Google, Steam or any OIDC provider work too (see .env.example).
# Register https://queueup.example.com/auth/discord/callback as the redirect URL.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Game search (IGDB, free via https://dev.twitch.tv/console/apps) ---
# Needed to add games. Can be entered in Administrator settings instead.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
