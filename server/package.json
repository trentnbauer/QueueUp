{
  "name": "@queueup/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "db:generate": "dotenv -e ../.env -- prisma generate --schema src/db/prisma/schema.prisma",
    "db:push": "dotenv -e ../.env -- prisma db push --schema src/db/prisma/schema.prisma",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev --schema src/db/prisma/schema.prisma",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema src/db/prisma/schema.prisma",
    "db:studio": "dotenv -e ../.env -- prisma studio --schema src/db/prisma/schema.prisma",
    "backfill:badges": "tsx src/scripts/backfillBadges.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@queueup/shared": "*",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.2",
    "openid-client": "^6.8.8",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
