generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  backlog
  playing
  done
  /// "We bounced off this and aren't going back" - distinct from done so it doesn't pollute
  /// completion stats, and excluded from Spin the Wheel same as playing/done.
  dropped
  /// Not yet owned/added for real - tracked so pricing/ATL alerts are useful before a purchase,
  /// not just after. Excluded from Spin the Wheel same as done/dropped (nothing to play yet).
  wishlist
  /// Beaten before, and queued to play again - included in Spin the Wheel's candidate pool same
  /// as backlog (that's the whole point of flagging it), but kept distinct from backlog so it can
  /// be labeled/filtered separately rather than looking like it was never played.
  replay
  /// "Up next" - a deliberate manual pick queued ahead of the rest of the backlog, shown in the
  /// same "Currently Playing" strip as playing (not a second separate strip) so it reads as "what's
  /// active/imminent right now" rather than just another backlog entry. Excluded from Spin the
  /// Wheel's candidate pool same as playing/done/dropped (see backlogGames in gameGridLogic.ts) -
  /// once something's queued up next, the wheel shouldn't be able to bump it for something else.
  play_next
  /// "Never going to play this" (issue #569) - distinct from `dropped`: dropped means "started it,
  /// bounced off", wont_play means "decided against it, possibly without ever starting" (e.g.
  /// clearing out backlog cruft). Excluded from Spin the Wheel/Ranked Queue same as dropped, and
  /// shown alongside dropped in one combined "Dropped / Won't Play" strip rather than a third
  /// permanently-visible section.
  wont_play

  @@map("game_status")
}

enum RoomRole {
  room_master
  moderator
  member

  @@map("room_role")
}

enum RoomPlatform {
  pc
  xbox_360
  xbox_one
  xbox_series
  ps3
  ps4
  ps5
  switch
  switch2

  @@map("room_platform")
}

/// Which visual presentation Spin the Wheel uses (issue #297) - room master only to change, same
/// gating as Room.spinOwnershipMaxPrice. "random" isn't itself a renderable theme - it resolves to
/// one of the other four at spin time (see resolveConcreteTheme in the web app), re-rolled fresh
/// on every spin rather than fixed once per room.
enum SpinWheelTheme {
  slot
  crate
  card_flip
  roulette
  random

  @@map("spin_wheel_theme")
}

enum NotificationType {
  game_added
  member_joined
  room_renamed
  room_platform_changed
  room_owner_changed
  room_deleted
  price_drop
  /// A member suggested a game for a room with requireGameApproval on (issue #362) - notifies the
  /// room so a Room Master/Moderator knows to go approve or decline it.
  game_suggested
  /// A new sequel or DLC entry showed up on IGDB for a game the recipient has beaten on their
  /// Personal Shelf (issue #510, see jobs/releaseWatchJob.ts) - always a direct (recipientId)
  /// notification, never room-scoped, same as price_drop's Personal Shelf branch.
  release_watch
  /// A Personal Shelf game's Steam playtime increased while it wasn't already Playing (issue #554,
  /// see jobs/playtimeSnapshotJob.ts) - always direct and always carries gameId, so the client can
  /// offer a one-click "Mark Playing" action (see Notification.gameId below). Same
  /// gated-behind-PLAYTIME_TRACKING_ENABLED reasoning as the rest of issue #548.
  playtime_mark_playing
  /// A Playnite-linked user hasn't synced in 48+ hours (issue #570, see
  /// jobs/playniteSyncReminderJob.ts) - always direct (recipientId), never room-scoped, same shape
  /// as release_watch. "Synced" is approximated by ApiKey.lastUsedAt on their Playnite Import key,
  /// same signal PlayniteImportModal's own linking step already polls.
  playnite_sync_reminder

  @@map("notification_type")
}

/// See RoomActivity's doc comment. A superset of NotificationType's room-scoped values (everything
/// notifyRoom is ever called with, plus price_drop) minus room_deleted (the room and its
/// RoomActivity rows are already gone by then, so there'd be nothing left to attach it to), plus
/// the events below that are feed-worthy but deliberately too frequent/low-stakes for the bell.
enum RoomActivityType {
  game_added
  game_suggested
  member_joined
  room_renamed
  room_platform_changed
  room_owner_changed
  price_drop
  /// A room game's status changed (Backlog/Playing/Done/Dropped/Wishlist/Replay/Play Next).
  status_changed
  /// A member cast or updated their 1-5 vote on a room game.
  vote_cast
  /// Spin the Wheel settled and a member committed to the winner ("Let's play").
  spin_result
  /// A member's role changed to Moderator or Room Master (see first_promoted in badges.ts for the
  /// same "member -> moderator, or any -> room_master" distinction).
  member_promoted
  /// A member left, or was removed by a Room Master/Moderator.
  member_left

  @@map("room_activity_type")
}

model User {
  id                   String         @id @default(uuid())
  oidcSub              String         @unique @map("oidc_sub")
  /// Set when this user links a Steam account without signing in with it directly (oidcSub is
  /// already taken by their primary sign-in provider) - see the Steam-link flow in auth.ts.
  /// Steam sign-in users don't need this populated; their Steam ID lives in oidcSub instead.
  steamId64            String?        @unique @map("steam_id64")
  email                String
  displayName          String         @map("display_name")
  avatarColor          String         @default("#8f8aa8") @map("avatar_color")
  avatarUrl            String?        @map("avatar_url")
  isAdmin              Boolean        @default(false) @map("is_admin")
  createdAt            DateTime       @default(now()) @map("created_at")
  /// Systems the user has ticked as "owned" on their Personal Shelf - scopes the add-game
  /// search/create flow there the same way a Room's platform scopes it for a room. Empty means
  /// no opt-in yet, so no filtering is applied (preserves pre-existing behavior).
  ownedPlatforms       RoomPlatform[] @default([]) @map("owned_platforms")
  /// Opt-in (issue #511) for the public, unauthenticated `/u/:id` profile page (badges, Beaten
  /// count, Currently Playing) - defaults off, same "opt-in per-user" shape as a Room's own
  /// isPublic toggle. This id itself is already unguessable (a UUID, same as every other id in
  /// this schema), so there's no separate public-facing slug to manage - toggling this on is what
  /// actually makes GET /api/public/users/:id start answering instead of 404ing.
  publicProfileEnabled Boolean        @default(false) @map("public_profile_enabled")

  roomsCreated              Room[]                     @relation("RoomCreatedBy")
  memberships               RoomMember[]
  gamesAdded                Game[]
  votes                     Vote[]
  auditLogEntries           AdminAuditLog[]
  notificationsReceived     Notification[]             @relation("NotificationRecipient")
  notificationsActed        Notification[]             @relation("NotificationActor")
  roomActivity              RoomActivity[]             @relation("RoomActivityActor")
  gameSuggestions           GameSuggestion[]
  ownedGames                GameOwnership[]
  playtimeSnapshots         PlaytimeSnapshot[]
  achievementCompletions    AchievementCompletion[]
  badges                    UserBadge[]
  releaseWatchNotifications ReleaseWatchNotification[]
  linkedIdentities          LinkedIdentity[]
  tags                      Tag[]
  roomSpinsStarted          RoomSpin[]
  apiKeys                   ApiKey[]
  pendingLibraryImports     PendingLibraryImport[]

  @@map("users")
}

/// A non-primary sign-in method attached to a user, letting them log into one account with more
/// than one OAuth provider (e.g. primary sign-in via Discord, with Google also linked). The
/// original sign-in identity a user signs up with always stays on User.oidcSub; only providers
/// linked afterward go here. Steam is the one exception - linking Steam still writes
/// User.steamId64 instead of a row here (see that field's comment), so the already-tested
/// Steam-library-import path (steamLibrary.ts) didn't need to change to support this.
model LinkedIdentity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  oidcSub   String   @unique @map("oidc_sub")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One linked identity per provider per user - relinking the same provider (e.g. switching which
  // Google account is linked) replaces the row rather than accumulating a second one.
  @@unique([userId, provider])
  @@map("linked_identities")
}

/// A personal access token for the read/write API (issue #435) - lets an external system (a
/// script, a Playnite extension, a home dashboard) pull/push this user's library without
/// impersonating a real browser session. Scoped to the user only, not to a specific room: a
/// request authenticated with one of these resolves to the same userId a cookie session would,
/// so room access is whatever that user's own membership/role already allows (requireMembership/
/// requireElevated), not a separate permission model. Only `hash` (SHA-256 of the raw token) is
/// ever stored - the raw value is shown once, at creation, same principle as a session secret.
/// Revocation is soft (revokedAt) rather than a delete, so "when did this stop working" stays
/// visible in the management UI instead of the row just vanishing.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  hash       String    @unique
  label      String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// A crowd-sourced (source, title) -> igdbId mapping, remembered once any user's title resolves to
/// an igdbId - whether via an exact IGDB title match or a person manually picking a candidate for a
/// PendingLibraryImport row (see that model). Purpose: the next library import - this same user's
/// next sync, or a completely different user whose external library happens to report the exact
/// same title string (e.g. two different people's Playnite exports both saying "The Legend of
/// Zelda: Breath of the Wild" from the Nintendo source) - resolves instantly from this table
/// instead of re-running an IGDB search or, worse, landing in the review queue a second time for
/// a title someone already resolved once. Keyed by normalized title (see
/// normalizeGameTitleForComparison), not by user - a title string's correct igdbId doesn't depend
/// on who's importing it. `source` scopes this per external-library source (e.g. "playnite") so a
/// future source with differently-shaped titles can't cross-pollute another source's aliases.
model TitleMatchAlias {
  source          String
  normalizedTitle String   @map("normalized_title")
  igdbId          Int      @map("igdb_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@id([source, normalizedTitle])
  @@map("title_match_aliases")
}

/// An external-library title (e.g. from a Playnite import) that didn't resolve to an igdbId - no
/// exact IGDB title match, and no TitleMatchAlias on file for it either. Surfaced in a review UI
/// (Profile Settings, alongside the Playnite Import section from issue #441) so resolving it is
/// "glance at a few candidate covers and click," not "search from scratch" - see `candidates`.
/// Unique per (userId, source, title) so a repeat sync of the same still-unresolved title updates
/// the existing row (refreshing its candidates) instead of accumulating duplicates - without this,
/// a user syncing on every Playnite launch would see their review queue grow without bound purely
/// from re-imports of titles they haven't gotten around to reviewing yet.
model PendingLibraryImport {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  title      String
  /// Which RoomPlatform(s) this title was reported as owned on by the source - carried through so
  /// resolving this later (picking a candidate) can set GameOwnership.platforms correctly.
  platforms  RoomPlatform[] @default([])
  /// Free text, not an enum - meant to generalize to future external-library sources without a
  /// schema migration each time. "playnite" today.
  source     String
  /// Up to a handful of IGDB search results captured at import time (igdbId, title, platform,
  /// coverImageUrl, releaseYear - same shape as GameSearchResult) - empty when IGDB's search
  /// returned nothing at all for this title. Snapshotted at import time rather than searched fresh
  /// when the review UI loads, so opening the review list doesn't mean re-hitting IGDB once per
  /// pending row.
  candidates Json           @default("[]")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, title])
  @@map("pending_library_imports")
}

/// A user's ownership claim on a game, keyed by igdbId (not a specific Game row) - this is a fact
/// about the user and the title, not about any one shelf/room listing of it, so a Steam import (or
/// a manual toggle) marking a game owned automatically applies everywhere that igdbId shows up
/// across every room and the Personal Shelf, with nothing to "sync." Steam import writes these
/// automatically (always `[pc]` - Steam ownership only ever implies PC); the Add Game modal and a
/// room's ownership toggle write/update it manually.
model GameOwnership {
  userId    String         @map("user_id")
  igdbId    Int            @map("igdb_id")
  /// Which platform(s) this claim covers - a room only counts a game as owned when its own
  /// `Room.platform` is in this list (see getOwnershipInfo), so owning a title on Switch doesn't
  /// silently mark it owned in a PC room. Empty means "platform unknown" - every row from before
  /// this field existed - and is treated as owned everywhere, the same behavior this whole model
  /// had before this fix, so no existing ownership claim silently disappears; every new claim
  /// going forward is written with at least one specific platform.
  platforms RoomPlatform[] @default([]) @map("platforms")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, igdbId])
  @@map("game_ownership")
}

/// A user's last-known Steam playtime for one app, refreshed by the playtime-snapshot job (issue
/// #548, gated behind PLAYTIME_TRACKING_ENABLED). Keyed by (userId, steamAppId) rather than igdbId
/// - this is a raw fact straight from Steam's GetOwnedGames, which only knows appIds, and joining
/// it back to a specific Game row (Game.steamAppid) is a concern for whatever reads this table,
/// not this table itself. playtimeMinutes is overwritten in place each poll (no history kept) -
/// later pieces of #548 that need a fixed point-in-time baseline (e.g. "playtime when this was
/// marked Playing") persist their own copy of the value at that moment rather than relying on this
/// row staying put. initialMinutes is the one exception: set once at row creation and never
/// touched again, so a game that already had hours logged before tracking started has something
/// better than 0 to count "since checkpoint" from once it's tracked (see
/// getPlaytimeSinceCheckpoint) - without it, every pre-existing hour on a never-before-tracked
/// game would misread as "just played" the moment this feature is turned on.
model PlaytimeSnapshot {
  userId          String   @map("user_id")
  steamAppId      Int      @map("steam_app_id")
  playtimeMinutes Int      @map("playtime_minutes")
  initialMinutes  Int      @map("initial_minutes")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, steamAppId])
  @@map("playtime_snapshots")
}

/// A per-user, per-title fact that this user's Steam achievement progress has hit 100% at least
/// once, keyed by igdbId (not gameId) like GameOwnership - so it transfers across re-adds and
/// between rooms/shelf the same way ownership does, rather than being tied to one Game row. Sticky
/// by construction: rows are only ever inserted, never deleted or "un-completed", since a 100% run
/// stays true forever regardless of later achievement resets. Populated opportunistically wherever
/// achievement progress is already being checked (the achievements route, and Steam completion
/// auto-detection) - never a fresh Steam API call of its own. Powers the per-member "completed /
/// 100%'d" counts shown in a room's member list.
model AchievementCompletion {
  userId    String   @map("user_id")
  igdbId    Int      @map("igdb_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, igdbId])
  @@map("achievement_completion")
}

/// One row per user per badge ever unlocked in QueueUp's own gamification system (issue #489) -
/// sticky, insert-only, same shape as AchievementCompletion above. Deliberately named "badge" not
/// "achievement" in code: AchievementCompletion/AchievementRow/useGameAchievements/
/// PlayerAchievements already mean "this user's Steam achievement progress on this title" - an
/// unrelated, pre-existing concept. `badgeKey` is a stable string key into BADGE_DEFINITIONS
/// (packages/shared/src/badges.ts), not a foreign key - the catalog of what a badge means (name,
/// description, emoji) lives in code, not the DB, so adding a new badge later is a code change,
/// not a migration.
model UserBadge {
  userId    String   @map("user_id")
  badgeKey  String   @map("badge_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeKey])
  @@map("user_badges")
}

enum ReleaseWatchKind {
  sequel
  dlc

  @@map("release_watch_kind")
}

/// One row per user per newly-discovered sequel/DLC IGDB entry ever notified about (issue #510) -
/// insert-only, same idempotency shape as UserBadge above: the composite key is what makes a
/// notification fire at most once ever per (user, discovered title), regardless of how many of the
/// user's beaten games point at the same collection/base game, or how many job runs pass before
/// the user actually does anything about it. Not scoped to which beaten game led to the discovery -
/// only the discovered title's own igdbId matters for "have we already told this user about this."
model ReleaseWatchNotification {
  userId    String           @map("user_id")
  /// The IGDB id of the newly-discovered sequel/DLC entry itself, not the beaten game that led to
  /// it - see releaseWatch.ts.
  igdbId    Int              @map("igdb_id")
  kind      ReleaseWatchKind
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, igdbId])
  @@map("release_watch_notifications")
}

model Room {
  id                    String         @id @default(uuid())
  name                  String
  /// Null means "any platform" (issue #473) - a room can be created without locking to one
  /// console/PC, in which case platform-gated checks (suggestion matching, candidate IGDB platform
  /// resolution) fall back to per-game/per-user platform data instead of this single field. See
  /// assertPlatformMatch in gameIntake.ts. The per-room ownership toggle (routes/games.ts) has no
  /// such fallback - it refuses outright when this is null, since GameOwnership is keyed globally
  /// by (userId, igdbId), not per room, so there's no single platform here to safely write a claim
  /// against.
  platform              RoomPlatform?
  inviteCode            String         @unique @map("invite_code")
  accentColor           String         @default("#8b5cf6") @map("accent_color")
  createdBy             String         @map("created_by")
  createdAt             DateTime       @default(now()) @map("created_at")
  /// Posts the same events as the in-app room notification feed to this Discord channel webhook,
  /// if set (see notifications.ts). One-way egress only - QueueUp never reads anything back from it.
  discordWebhookUrl     String?        @map("discord_webhook_url")
  /// Room Settings dollar threshold (issue #339, replacing the old spinOnlyFullyOwned toggle):
  /// the game-picker's candidate pool is games every current member owns, OR games with a live
  /// price at or under this many dollars (see gameOwnership.ts / SpinPickerButton) - so a room can
  /// loosen "everyone must already own it" into "or it's cheap enough that buying in isn't a big
  /// ask." $0 reproduces the old fully-owned-only behavior.
  spinOwnershipMaxPrice Int            @default(15) @map("spin_ownership_max_price")
  /// Which visual presentation Spin the Wheel uses (issue #297) - defaults to the original
  /// slot-machine reel so existing rooms don't change.
  spinWheelTheme        SpinWheelTheme @default(slot) @map("spin_wheel_theme")
  /// When true, this room is listed in the public room directory (GET /api/rooms/public) and any
  /// signed-in user can self-join it instantly via POST /api/rooms/:roomId/join-public, without an
  /// invite code. Defaults to false (invite-only) so existing rooms are unaffected. The invite-code
  /// join path (POST /api/rooms/join) still works regardless of this flag.
  isPublic              Boolean        @default(false) @map("is_public")
  /// When true, a plain Member's "add a game" becomes a suggestion (see GameSuggestion) that a Room
  /// Master/Moderator must approve before it lands in the real backlog, rather than adding directly
  /// (issue #362). Defaults to false so existing rooms behave exactly as before - Room Masters and
  /// Moderators always add directly regardless of this flag, since they're the ones who'd otherwise
  /// be approving their own suggestion.
  requireGameApproval   Boolean        @default(false) @map("require_game_approval")

  creator       User             @relation("RoomCreatedBy", fields: [createdBy], references: [id])
  members       RoomMember[]
  games         Game[]
  notifications Notification[]
  activity      RoomActivity[]
  suggestions   GameSuggestion[]
  spin          RoomSpin?

  @@map("rooms")
}

/// A room's shared, in-progress Spin the Wheel session (issue #356 follow-up: click the left side
/// to slow it down, the right side to speed it up, and change where it lands) - one active spin
/// per room (roomId is unique), visible to every member currently looking at the room, not just
/// whoever clicked "Pick a Game". The candidate strip and (if the room's theme setting is
/// "random") the concrete theme are picked once here, server-side, so every member's client
/// travels the exact same strip instead of each independently calling Math.random() and
/// disagreeing (see spinPicker.ts/spinPhysics.ts in packages/shared, which both this route and the
/// client's own local Personal Shelf spin share). A nudge (left/right click) recomputes the
/// current position/velocity from the existing base and stores a *new* base plus a freshly
/// computed settlesAt/settledPosition (see roomSpin.ts) - every member's client derives the same
/// live position and, once settled, the same winner from that one snapshot, no per-frame
/// streaming required. No explicit "close" action deletes this row - closing the modal is a
/// purely local/per-viewer thing (see roomSpin.ts) - only committing a winner ("Let's play") or
/// going stale long enough to be treated as abandoned (see SPIN_STALE_MS) clears it.
model RoomSpin {
  id              String         @id @default(uuid())
  roomId          String         @unique @map("room_id")
  theme           SpinWheelTheme
  /// The circular, weighted candidate strip a spin's physics (see spinPhysics.ts in
  /// packages/shared) travels along - Game.id in strip order. Built once (start, or "Spin again")
  /// and never rebuilt by a nudge; a nudge only moves position0/velocity0/timestamp0 further along
  /// this same strip. Plain string array, not a relation - Postgres/Prisma can't express a
  /// to-many FK from an array column. If a strip game is deleted mid-spin (rare - would require
  /// someone removing a backlog game while a room is actively spinning on it), the spin can no
  /// longer be resolved and is treated as expired/absent (see roomSpin.ts) rather than left
  /// dangling on a stale reference.
  stripGameIds    String[]       @map("strip_game_ids")
  /// Position (in strip slots) at timestamp0 - see spinPhysics.ts's SpinBase. Together with
  /// velocity0/timestamp0, this is the *entire* state of an in-progress spin: both the server and
  /// every member's client derive the live position, and the eventual settle time/position, from
  /// this one snapshot via a shared closed-form formula - nothing else needs to be persisted or
  /// streamed per frame.
  position0       Float          @map("position0")
  /// Velocity (strip slots/second) at timestamp0 - positive is forward, negative is reversed
  /// (issue #487: repeated left nudges now reverse the spin rather than floor out at 0 - see
  /// spinPhysics.ts). Reset to a fresh (position0, velocity0, timestamp0) triple by every nudge,
  /// not adjusted in place, so a nudge mid-decay is still simple exponential decay from a new
  /// reference point rather than a sum of overlapping decay curves.
  velocity0       Float          @map("velocity0")
  timestamp0      DateTime       @map("timestamp0")
  /// Computed once, at start or on each nudge, from (position0, velocity0, timestamp0) via
  /// spinPhysics.ts's settlesAtOf/settledPositionOf - deliberately *not* computed lazily whenever
  /// something happens to check, since that would let two observers checking at different moments
  /// disagree on where a still-decaying spin will land. Once now() >= settlesAt, the winner is a
  /// pure read: stripGameIds[candidateIndexAt(settledPosition, stripGameIds.length)].
  settlesAt       DateTime       @map("settles_at")
  settledPosition Float          @map("settled_position")
  /// Bumped on every nudge - lets a client tell "did the base actually change" apart from a poll
  /// just re-confirming the same state, the same role spinKey played before nudging existed.
  nudgeCount      Int            @default(0) @map("nudge_count")
  /// Issue #488: ids of members who've opened Spin the Wheel while it's still in its pre-start
  /// waiting room (see the /spin/ready route and SPIN_WAITING_ROOM_MS in roomSpin.ts) - surfaced to
  /// every viewer as "N members ready" so the 30s wait actually shows who's shown up instead of
  /// counting down blind. Deliberately populated by a dedicated route the modal itself calls on
  /// mount, not by the GET route's background poll (which keeps running for anyone with the room
  /// open at all, whether or not they have this modal up) - see roomSpin.ts's /spin/ready doc. Only
  /// meaningful during the waiting window; reset to empty on every start/restart (a restart has no
  /// waiting window of its own - see roomSpin.ts - so it's simply unused until the next fresh
  /// start). Plain string array for the same reason as stripGameIds above.
  readyUserIds    String[]       @default([]) @map("ready_user_ids")
  startedBy       String         @map("started_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  starter User @relation(fields: [startedBy], references: [id], onDelete: Cascade)

  @@map("room_spins")
}

model RoomMember {
  roomId              String    @map("room_id")
  userId              String    @map("user_id")
  role                RoomRole  @default(member)
  joinedAt            DateTime  @default(now()) @map("joined_at")
  /// Cursor for this member's unread count in their room: notifications created after this (or
  /// after joinedAt, if they've never opened the room's notifications) count as unread. Kept on
  /// the membership row rather than a per-notification read-receipt table since a room's
  /// notification feed is shared by every member and "have I seen everything up to here" is all
  /// that's ever asked of it - a receipt per (notification, member) would track the same fact at
  /// far higher cost.
  notificationsReadAt DateTime? @map("notifications_read_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  /// Issue #524: the composite PK above indexes room_id first, so it can't serve the several
  /// call sites that look up a user's memberships with no roomId (getNotificationFeed/
  /// getNotificationSummary, DELETE /api/me's export path, several room-membership lookups in
  /// games.ts) - those fall back to a sequential scan without this.
  @@index([userId])
  @@map("room_members")
}

model Game {
  id                           String     @id @default(uuid())
  roomId                       String?    @map("room_id")
  addedBy                      String     @map("added_by")
  igdbId                       Int        @map("igdb_id")
  title                        String
  platform                     String
  genre                        String?
  /// Captured at intake time from IGDB - not re-fetchable later without hitting IGDB again per
  /// game, so this needs to be saved when the game is added, not derived after the fact.
  releaseYear                  Int?       @map("release_year")
  /// Full release date/time (issue #284) - releaseYear alone is only precise to the year, which
  /// isn't enough to reliably tell "already released" from "releasing later this year" for Spin
  /// the Wheel's isUnreleased check. Null on games added before this field existed; that check
  /// falls back to the year-only heuristic for those rather than requiring a backfill.
  releaseDate                  DateTime?  @map("release_date")
  /// IGDB's franchise/series id for this game, if it belongs to one (issue #283) - captured at
  /// intake same as releaseYear/maxCoopPlayers above. Not surfaced anywhere yet; laying the
  /// groundwork for a future "recommend playing the prior entry first" Spin the Wheel feature
  /// without needing a second IGDB round trip per game once that's built. Null on games added
  /// before this field existed, and on any game IGDB doesn't have in a collection.
  igdbCollectionId             Int?       @map("igdb_collection_id")
  maxCoopPlayers               Int?       @map("max_coop_players")
  /// Hours for an average "main story" playthrough, from IGDB's game_time_to_beats endpoint
  /// (issue #189) - same capture-at-intake reasoning as releaseYear/maxCoopPlayers above. Null
  /// when IGDB has no time-to-beat data for this game. Sourced from IGDB's "normally" figure -
  /// kept as-is (issue #248) so this column's meaning doesn't shift out from under rows already
  /// on file; see timeToBeatRushedHours/timeToBeatCompletionistHours for the rest of the
  /// breakdown IGDB exposes alongside it.
  timeToBeatHours              Int?       @map("time_to_beat_hours")
  /// Hours for a rushed/speedrun-style playthrough, from IGDB's game_time_to_beats "hastily"
  /// figure (issue #248) - same capture-at-intake reasoning as timeToBeatHours above. Null when
  /// IGDB has no time-to-beat data for this game. This is always less time than timeToBeatHours
  /// (Main Story), not more - the three game_time_to_beats figures are strictly ordered hastily <
  /// normally < completely - so it's additive alongside timeToBeatHours rather than replacing it,
  /// but represents a quicker/less-thorough clear, not a fuller one.
  timeToBeatRushedHours        Int?       @map("time_to_beat_rushed_hours")
  /// Hours for a full completionist (100%) playthrough, from IGDB's game_time_to_beats
  /// "completely" figure (issue #248) - same capture-at-intake reasoning as timeToBeatHours
  /// above. Null when IGDB has no time-to-beat data for this game.
  timeToBeatCompletionistHours Int?       @map("time_to_beat_completionist_hours")
  /// 0-100 review score (issue #311) - IGDB's total_rating (blended critic+user), falling back to
  /// aggregated_rating (critic-only) then rating (user-only) if the preferred figure is missing -
  /// see reviewScoreFrom in igdbClient.ts. Same capture-at-intake reasoning as maxCoopPlayers
  /// above. Null when IGDB has no review data at all for this game (not a penalty - Spin the
  /// Wheel's weighting treats it the same as a game nobody's voted on), or on games added before
  /// this field existed.
  reviewScore                  Int?       @map("review_score")
  ggDealsUrl                   String?    @map("gg_deals_url")
  steamAppid                   Int?       @map("steam_appid")
  coverImageUrl                String?    @map("cover_image_url")
  status                       GameStatus @default(backlog)
  /// Set the first time any player's Steam achievement progress on this game is observed at
  /// 100% (opening the detail modal, "Sync completions from Steam", or Year in Review) - never
  /// computed live on every grid render, which would mean a Steam API call per Steam-linked game
  /// per page view. Drives the card ribbon showing "Clocked" (gold) instead of "Beaten" (green)
  /// for a Done game. Sticky once true - a later Replay doesn't clear it, since it's a record of
  /// "this has been 100%'d before," not "the current playthrough is 100%'d."
  steamFullyCompleted          Boolean    @default(false) @map("steam_fully_completed")
  createdAt                    DateTime   @default(now()) @map("created_at")
  updatedAt                    DateTime   @updatedAt @map("updated_at")
  /// Set by the admin bulk-archive action (Done games untouched for 90+ days) - archived games are
  /// hidden from normal shelf/room listings but not deleted, preserving history.
  archivedAt                   DateTime?  @map("archived_at")
  /// A price to alert at, set by any user who can see the game (string decimal, matching the
  /// existing price-string convention - see GamePrice). Shared per-game rather than per-user: a
  /// room game has one target that notifies the whole room, same as any other room notification.
  /// Cleared automatically once the alert fires (see priceAlerts.ts) so a price that stays low
  /// doesn't re-notify on every subsequent page load.
  targetPrice                  String?    @map("target_price")
  /// A user-set fallback dollar amount (issue #385), shown in place of "-" wherever the price
  /// couldn't be looked up (no gg.deals/Steam match at all - see GamePrice.amount/source) - some
  /// games just aren't findable there. Same string-decimal convention as targetPrice. Ignored once
  /// a live price becomes available, since that's always more current.
  manualPrice                  String?    @map("manual_price")
  /// The live price we last sent an all-time-low alert for (see priceAlerts.ts) - lets us notify
  /// again if the price drops even further, without re-notifying on every subsequent check while
  /// it sits at the same low. Independent of targetPrice, which is a user-set threshold.
  notifiedAtlPrice             String?    @map("notified_atl_price")
  /// User-set "play this after" pointer to another game in the same room (issue: play-after
  /// dropdown) - e.g. Borderlands 2 pointed at Borderlands 1. Purely organizational: nothing
  /// enforces it at write time beyond same-room + not-self (checked at the API layer, not here),
  /// but Spin the Wheel's candidate pool excludes a game with an unmet prerequisite (its target
  /// not yet marked Done) - see hasUnmetPrerequisite in gameGridLogic.ts. SetNull on delete rather
  /// than blocking the delete: removing the prerequisite game should un-stick its successor, not
  /// prevent the removal.
  prerequisiteGameId           String?    @map("prerequisite_game_id")
  /// Set at intake time (issue #338) when IGDB identifies this game as DLC/an expansion with a
  /// known parent - points at that base game's row in the *same* room/shelf scope, auto-creating
  /// it first if it wasn't already added (see linkDlcToBaseGame in gameIntake.ts). Unlike
  /// prerequisiteGameId above, this isn't user-editable via any dropdown - it's a structural fact
  /// about the game itself, not an organizational "play order" pointer, so there's no UI that lets
  /// someone repoint or clear it. SetNull on delete, same reasoning as prerequisiteGameId - removing
  /// the base game shouldn't block removing (or orphan) its DLC.
  baseGameId                   String?    @map("base_game_id")

  room             Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  adder            User      @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  votes            Vote[]
  tags             GameTag[]
  prerequisiteGame Game?     @relation("GamePrerequisite", fields: [prerequisiteGameId], references: [id], onDelete: SetNull)
  successorGames   Game[]    @relation("GamePrerequisite")
  baseGame         Game?     @relation("GameBaseGame", fields: [baseGameId], references: [id], onDelete: SetNull)
  dlc              Game[]    @relation("GameBaseGame")
  playLogs         PlayLog[]
  notifications    Notification[]

  @@index([roomId])
  @@index([addedBy], map: "idx_games_personal")
  @@index([roomId, igdbId])
  @@index([addedBy, igdbId])
  @@index([prerequisiteGameId])
  @@index([baseGameId])
  @@map("games")
}

/// A dated log entry for one playthrough attempt (issue #361) - Game.status is a single mutable
/// field with no history of its own, so there was no record of when a game was actually started or
/// finished, and a Replay overwrote rather than added to that history. `startedAt` is set the
/// moment a game is marked Playing; `finishedAt` is set when it's marked Done or Dropped, and stays
/// null while still in progress (see recordStatusTransition.ts - resuming an unfinished attempt,
/// e.g. Playing -> Backlog -> Playing, reuses this same open entry rather than starting a
/// duplicate one). A Replay queued back up and played again gets its own new entry once nothing is
/// left open, rather than reopening/overwriting this one.
model PlayLog {
  id         String    @id @default(uuid())
  gameId     String    @map("game_id")
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Steam playtime (all-time, minutes) snapshotted at startedAt/finishedAt respectively (issue
  /// #548, gated behind PLAYTIME_TRACKING_ENABLED - see currentPlaytimeMinutesForGame). Both null
  /// for any entry closed before this field existed, or whenever the game/its adder has no Steam
  /// playtime data to attribute (see that function's doc comment for exactly when). Subtracting
  /// the two gives this specific playthrough's actual played hours, distinct from wall-clock time
  /// between startedAt/finishedAt (which includes any stretch the game sat untouched).
  startPlaytimeMinutes  Int? @map("start_playtime_minutes")
  finishPlaytimeMinutes Int? @map("finish_playtime_minutes")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("play_log")
}

/// A lightweight nomination for a room game, pending a Room Master/Moderator's approve-or-decline
/// (issue #362) - only created when the room's requireGameApproval is on and the suggester is a
/// plain Member. Deliberately its own table rather than a new GameStatus value: a status enum
/// member would leak into every status-list/status-pill site across the app (grid grouping, bulk
/// actions, exports, ...) that has nothing to do with pre-approval curation. No `status` column
/// here either - a row's mere existence means "pending"; approving or declining it deletes the row
/// (approving also creates the real Game via the same full-intake path POST /api/games uses).
/// Captures just enough at suggest time to render a review row (title/platform/cover/releaseYear
/// from a single IGDB detail lookup) - the expensive parts of intake (Steam app id resolution,
/// gg.deals pricing) are deferred until approval, since a declined suggestion should never have
/// paid for those.
model GameSuggestion {
  id            String   @id @default(uuid())
  roomId        String   @map("room_id")
  igdbId        Int      @map("igdb_id")
  title         String
  platform      String
  coverImageUrl String?  @map("cover_image_url")
  releaseYear   Int?     @map("release_year")
  suggestedBy   String   @map("suggested_by")
  createdAt     DateTime @default(now()) @map("created_at")

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  suggester User @relation(fields: [suggestedBy], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("game_suggestions")
}

model Vote {
  gameId    String   @map("game_id")
  userId    String   @map("user_id")
  // 1-5, validated at the API layer AND by a DB-level CHECK constraint (votes_value_range) -
  // Prisma's schema DSL has no CHECK support, so that constraint is applied at boot instead,
  // see db/ensureConstraints.ts.
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameId, userId])
  @@map("votes")
}

/// A user-defined organizational label (issue #247), layered on top of the fixed GameStatus enum -
/// e.g. "Co-op only" or "Short & sweet". Deliberately per-user rather than global/shared: a tag you
/// create applies across your own Personal Shelf items and any room games you added (see GameTag's
/// access rule in gameAccess.ts), the same way GameOwnership and the Personal Shelf itself are
/// scoped to a user rather than a room. Not visible to (or editable by) other room members, even on
/// a shared room game - this is a personal filing scheme, not a room feature (out of scope per the
/// issue). Schema-only change, additive and `db push`-safe like the rest of this file (no migration
/// history is kept - see server/src/db/ensureConstraints.ts's comment for why).
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  games GameTag[]

  // A user can't create two tags with the same name - the create/rename routes rely on this
  // constraint (via a caught P2002, same pattern as the room invite-code/LinkedIdentity routes)
  // rather than a separate SELECT-then-INSERT existence check.
  @@unique([userId, name])
  @@map("tags")
}

/// Join row for the per-user Tag <-> Game many-to-many (issue #247). Keyed on the specific Game row
/// (not igdbId, unlike GameOwnership) - a tag is an organizational label on one shelf/room listing,
/// not a fact about the title itself, so tagging one copy of a game says nothing about another
/// listing of the same title elsewhere (e.g. the same game on your shelf AND in a room). Cascades in
/// both directions: deleting a Game drops its tag associations, and deleting a Tag drops it from
/// every game it was on - there's no "can't delete, still in use" guard (see the tag-delete route
/// for that reasoning).
model GameTag {
  gameId    String   @map("game_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
  @@map("game_tags")
}

/// Room-activity feed entry: game added, member joined, room renamed/platform/owner changed, or a
/// room deletion notice. Room-scoped entries (roomId set) are shared by every current member and
/// read state is tracked via RoomMember.notificationsReadAt rather than per-row, since the same
/// row is "the same notification" for everyone in the room. Direct entries (recipientId set, roomId
/// null) exist only for events with no room left to attach to - namely a room being deleted, where
/// each former member gets their own row (with readAt tracked right here, since it's addressed to
/// exactly one person) so the notice survives the room it's about.
/// roomName is a snapshot taken at creation time rather than a live join through roomId, since a
/// direct notification about a deleted room has no room row left to join through.
model Notification {
  id          String           @id @default(uuid())
  roomId      String?          @map("room_id")
  roomName    String           @map("room_name")
  recipientId String?          @map("recipient_id")
  actorId     String?          @map("actor_id")
  type        NotificationType
  message     String
  createdAt   DateTime         @default(now()) @map("created_at")
  /// Only meaningful for direct (recipientId set) rows - see the model doc above.
  readAt      DateTime?        @map("read_at")
  /// The specific game this notification is about, if any (issue #554's playtime_mark_playing is
  /// the first type to set this) - lets the client's action button target the right game without
  /// parsing `message`. SetNull rather than Cascade on delete: a removed game shouldn't take an
  /// already-delivered notification with it, just leave it unable to offer its action anymore.
  gameId      String?          @map("game_id")

  room      Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recipient User? @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  game      Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// A full, paginated per-room history (issue #509) - deliberately separate from Notification
/// above rather than reusing its table: Notification's whole shape (recipientId/readAt, the
/// bell's unread count) is built around "things you haven't seen yet," and folding
/// high-frequency events like every vote or status change into that would flood the bell for
/// events nobody needs an interruption for. This is pull-based (you open the feed to look back),
/// so there's no read/unread state at all - just an append-only log, newest first.
/// Room events that already write a Notification (game added, member joined, room renamed, ...)
/// also write a matching row here - see notifyRoom/notifyPriceDrop in services/notifications.ts,
/// the single choke point for both. Events with no separate notification (vote cast, status
/// changed, spin result, member promoted/left) call logRoomActivity (services/roomActivity.ts)
/// directly instead.
model RoomActivity {
  id        String           @id @default(uuid())
  roomId    String           @map("room_id")
  actorId   String?          @map("actor_id")
  type      RoomActivityType
  message   String
  createdAt DateTime         @default(now()) @map("created_at")

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor User? @relation("RoomActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("room_activity")
}

/// Durable record of destructive admin actions (user/room delete, bulk-archive) - a structured
/// log line alone doesn't survive log rotation or a container restart, so this is the actual
/// source of truth for "who did what, when." actorId is nullable with onDelete: SetNull rather
/// than Cascade so a log entry outlives the admin account that made it - actorLabel/targetLabel
/// are snapshots taken at write time so the entry stays meaningful even after that.
model AdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actorLabel  String   @map("actor_label")
  action      String
  targetLabel String?  @map("target_label")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_audit_log")
}

/// Small key-value fallback store for admin-configurable integration credentials (gg.deals API
/// key, IGDB client id/secret) that weren't set via env var - see
/// server/src/services/configResolver.ts, which always prefers the env var and only reads this
/// table to fill the gap when it's unset. Values are plain text: these are already admin-only
/// credentials shown (masked) to admins in the Settings UI. If this table ever grows to hold more
/// sensitive secrets, add encryption at rest before relying on it further - not done now to avoid
/// over-engineering a handful of low-sensitivity API keys.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}
